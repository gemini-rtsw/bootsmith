# Host settings for Bootsmith.  /etc/sysconfig/bootsmith
# %config(noreplace): your edits survive `dnf upgrade`.
# KEY=VALUE, no quotes. Restart to apply: systemctl restart bootsmith

# Host port for the web UI (the container always listens on 8080).
BOOTSMITH_PORT=8080

# Where operators push profile changes from /var/lib/bootsmith/profiles. Set as
# origin when the profiles repo is first created on this host. Change it to the
# internal git server once there is one (and run: git remote set-url origin ...).
BOOTSMITH_PROFILES_REMOTE=git@github.com:gemini-rtsw/bootsmith-config.git
